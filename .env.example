VITE_SUPABASE_ANON_KEY=your_anon_key

# Lemon Squeezy is no longer used. Payments (India: Razorpay planned) will be added server-side.
VITE_LEMONSQUEEZY_STORE_ID=
VITE_LEMONSQUEEZY_PREMIUM_MONTHLY_VARIANT_ID=
