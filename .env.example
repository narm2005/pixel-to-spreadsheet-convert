# Backend (FastAPI) the app talks to
VITE_API_URL=https://receipt2xcl.onrender.com

# Google OAuth client ID for the sign-in button (public value; must match GOOGLE_CLIENT_ID on the backend)
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# Lemon Squeezy is no longer used. Payments (India: Razorpay planned) will be added server-side.
VITE_LEMONSQUEEZY_STORE_ID=
VITE_LEMONSQUEEZY_PREMIUM_MONTHLY_VARIANT_ID=
VITE_LEMONSQUEEZY_PREMIUM_YEARLY_VARIANT_ID=
