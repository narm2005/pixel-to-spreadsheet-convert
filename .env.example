# Backend (FastAPI) the app talks to
VITE_API_URL=https://receipt2xcl.onrender.com

# Supabase is used only for sign-in (Google / email). Public values from Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Optional: currency for amounts (default INR)
VITE_CURRENCY=INR
